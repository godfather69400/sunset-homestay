# Copy to .env.local and fill in production values.

# Supabase Postgres (Transaction / pooled for Prisma runtime)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase direct connection (migrations)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Public site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="919817063210"

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxx"

# Admin dashboard
ADMIN_PASSWORD="change-me-strong-password"
ADMIN_SECRET="change-me-long-random-string"

# Protect Vercel cron
CRON_SECRET="change-me-cron-secret"

# WhatsApp (Twilio by default; set WHATSAPP_PROVIDER=meta for Cloud API)
WHATSAPP_PROVIDER="twilio"
TWILIO_ACCOUNT_SID="ACxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxx"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
WHATSAPP_OWNER_NUMBER="919817063210"

# Optional: also text failure alerts (payment errors, webhook issues, OTA
# sync problems, double-booking conflicts) to the developer's WhatsApp.
# Must be a Twilio WhatsApp sandbox/approved number, e.g. "9198xxxxxxx".
DEVELOPER_WHATSAPP_NUMBER=""

# Optional Meta WhatsApp Cloud API
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_CLOUD_PHONE_ID=""
